RewriteEngine On
RewriteRule ^core/ - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F,L]

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|log)$">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
