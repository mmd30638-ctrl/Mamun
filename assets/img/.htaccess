# নিরাপত্তা: ইউজার-আপলোড করা ছবি এই ফোল্ডারে সরাসরি সেভ হয় — তাই এখানে
# কোনো স্ক্রিপ্ট এক্সিকিউট হওয়া বন্ধ রাখা হলো।

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pht|phar|cgi|pl|py|sh|asp|aspx|exe|dll|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
