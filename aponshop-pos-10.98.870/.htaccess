Options -Indexes

# .env and .env.staging must never be downloadable, even inside public_html.
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# SQL dumps must not be downloadable from the website.
<FilesMatch "\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# AME-HOOK-V5 | DYNAMIC FRONT CONTROLLER ROUTER
RewriteEngine On
RewriteBase /

# Live domain is https://mavo12.online. www and HTTP share that one host
# so SSL and login cookies are not split across www / non-www.
RewriteCond %{HTTP_HOST} ^www\.mavo12\.online$ [NC]
RewriteRule ^ https://mavo12.online%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} ^mavo12\.online$ [NC]
RewriteRule ^ https://mavo12.online%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTP_HOST} !^staging\.aponshop\.site$ [NC]
RewriteCond %{HTTP_HOST} !^(www\.)?mavo12\.online$ [NC]
RewriteCond %{HTTP_HOST} !hostingersite\.com$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Private migration sources, nested release copies, and operational artifacts
# must never be served from the document root.
RewriteRule ^(?:data|public_html|migrations|tools|verification|docs|sql)(?:/|$) - [F,L,NC]
RewriteRule ^(?:install_wipe_data|import|check-db|bump_asset_version|cleanup_unused_files)\.php$ - [F,L,NC]
RewriteRule ^modules/settings/download_wipe_sql\.php$ - [F,L,NC]
RewriteRule ^uploads/(?:migrations|sql|scripts)(?:/|$) - [F,L,NC]

# Internal PHP libraries and server-rendered fragments must never be invoked
# as standalone HTTP endpoints. PHP include/require calls are unaffected.
RewriteRule ^(?:includes|partials)(?:/|$) - [F,L,NC]
RewriteRule ^modules/customers/(?:customer-card-popup|customer_ledger_functions|profile_(?:view|transaction_form|installments|2|3|4))\.php$ - [F,L,NC]
RewriteRule ^modules/inventory/add_product_(?:boot|form|style|script|code_style|code_section|code_script)\.php$ - [F,L,NC]
RewriteRule ^modules/rental/_(?:boot|foot|nav)\.php$ - [F,L,NC]
RewriteRule ^storage/shop_rent(?:/|$) - [F,L,NC]
RewriteRule ^(?:db_backups|storage/db_backups)(?:/|$) - [F,L,NC]
RewriteRule ^modules/shop_rent/_(?:home_alert|nav)\.php$ - [F,L,NC]
RewriteRule ^modules/returns/add_(?:form|script|style)\.php$ - [F,L,NC]
RewriteCond %{REQUEST_URI} !/pos_layout_designer\.php$ [NC]
RewriteCond %{REQUEST_URI} !/pos_party_search\.php$ [NC]
RewriteRule ^modules/sales/pos_[A-Za-z0-9_-]+\.php$ - [F,L,NC]
RewriteRule ^modules/settings/error_diagnostics_(?:style|view)\.php$ - [F,L,NC]

# এক ক্লিকে আপডেট ZIP — /get/Aponshop_POS_STACK_UPDATE.zip
RewriteRule ^get/([A-Za-z0-9._-]+\.zip)$ get.php?file=$1 [L,QSA,NC]

# যদি ফাইল বা ফোল্ডার বাস্তবে থাকে, তবে সরাসরি ওপেন হবে
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# যেকোনো অজানা/ভুল ইউআরএল রাউটার ফাইলের কাছে পাঠিয়ে দেবে
RewriteRule ^(.*)$ router.php [QSA,L]

# ---------------------------------------------------------------
# AME-HOOK-V5 | ব্রাউজার ক্যাশ নিয়ন্ত্রণ
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # sw.js নিজে কখনো ক্যাশ হবে না — নাহলে এর ভেতরের কোনো আপডেট
    # ব্রাউজারে কখনো পৌঁছাবে না (Service Worker আপডেট আটকে যাওয়ার মূল কারণ)
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # CSS/JS/images carry ?v=AME_ASSET_VERSION, so a year of cache is safe.
    # sw.js is set again below so this rule does not keep the worker file.
    <FilesMatch "\.(css|js|mjs|png|jpe?g|gif|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # -----------------------------------------------------------
    # সিকিউরিটি হেডার (আগে ছিল না)
    # -----------------------------------------------------------
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HTTPS-only site — HSTS enabled for update package 10.98.71+
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# HTML/CSS/JS gzip — ফোনের এমবি ও লোড সময় কমায় (SPEED.txt §১ — মুছবেন না)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_gzip.c>
    mod_gzip_on Yes
    mod_gzip_item_include mime ^text/.*
    mod_gzip_item_include mime ^application/javascript$
    mod_gzip_item_include mime ^application/json$
</IfModule>

# ---------------------------------------------------------------
# সংবেদনশীল ফাইল/ফোল্ডার সরাসরি ব্রাউজার থেকে অ্যাক্সেস বন্ধ
# ---------------------------------------------------------------
<FilesMatch "\.(env|log|sql|md|bak|dump|zip|rar|7z|ini|conf|old)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(INSTALLATION\.txt|SPEED\.txt|CREDENTIALS\.txt|INSTALL-BN\.txt|SALE\.txt|LIVE_DOMAIN\.txt)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule ^logs/ - [F,L]
</IfModule>
<IfModule LiteSpeed>
CacheDisable public /now.php
CacheDisable public /chuktis.php
CacheDisable public /modules/customers/hire/
</IfModule>