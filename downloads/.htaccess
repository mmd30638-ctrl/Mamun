# নিরাপত্তা: এই ফোল্ডারের ZIP সরাসরি লিংকে পাবলিকলি নামানো যাবে না।
# ডাউনলোড শুধু /download_static.php?file=... দিয়ে হবে, যা অ্যাডমিন লগইন চায়।
<FilesMatch "\.zip$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
